# Copy to .env and fill in. NEVER prefix the OpenAI vars with VITE_ — VITE_ vars are bundled into the browser.

# Supabase (public anon keys — fine in the browser)
VITE_PRODUCTION_SUPABASE_URL=https://<ref>.supabase.co/rest/v1/
VITE_PRODUCTION_SUPABASE_ANON_KEY=
VITE_ORDER_SUPABASE_URL=https://<ref>.supabase.co/rest/v1/
VITE_ORDER_SUPABASE_ANON_KEY=
VITE_PURCHASE_SUPABASE_URL=https://<ref>.supabase.co/rest/v1/
VITE_PURCHASE_SUPABASE_ANON_KEY=

# Chatbot (server only — read by server/chatHandler.js)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING=low
